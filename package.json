{
  "name": "tmr-transport-analysis-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Transport Analysis Unit prototype using React, TypeScript, pnpm workspaces, design tokens, MapLibre and scenario analytics.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @tmr/analyst dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @tmr/analyst build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tmr/analyst test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "jsdom": "latest",
    "sass": "latest",
    "@playwright/test": "latest"
  }
}
